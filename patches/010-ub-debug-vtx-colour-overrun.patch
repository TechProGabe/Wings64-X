diff --git a/src/kernel/debug.c b/src/kernel/debug.c
index 71ba171..8d5e6c9 100644
--- a/src/kernel/debug.c
+++ b/src/kernel/debug.c
@@ -684,11 +684,29 @@ void uvDbg_802338A8(f32 arg0, f32 arg1) {
 
 void uvDbg_802339B0(u8 r, u8 g, u8 b, u8 a) {
     s32 idx;
+#ifdef WINGS64_XBOX
+    // PORT: IDO placed D_8024B348/428/518/528 back to back (0x26 Vtx in total) and this loop
+    // coloured all four through the first array; GCC/clang give no layout guarantee, so walk each.
+    Vtx_t* const dcArrays[4] = { D_8024B348, D_8024B428, D_8024B518, D_8024B528 };
+    const s32 dcCounts[4] = { ARRAY_COUNT(D_8024B348), ARRAY_COUNT(D_8024B428), ARRAY_COUNT(D_8024B518),
+                              ARRAY_COUNT(D_8024B528) };
+    s32 dcArr;
+    STATIC_ASSERT(sizeof(D_8024B348) + sizeof(D_8024B428) + sizeof(D_8024B518) + sizeof(D_8024B528) ==
+                      0x26 * sizeof(Vtx_t), "debug vertex arrays cover the 0x26-entry colour loop");
+    for (dcArr = 0; dcArr < 4; dcArr++) {
+        for (idx = 0; idx < dcCounts[dcArr]; idx++) {
+            dcArrays[dcArr][idx].cn[0] = r;
+            dcArrays[dcArr][idx].cn[1] = g;
+            dcArrays[dcArr][idx].cn[2] = b;
+            dcArrays[dcArr][idx].cn[3] = a;
+        }
+#else
     for (idx = 0; idx < 0x26; idx++) {
         D_8024B348[idx].cn[0] = r;
         D_8024B348[idx].cn[1] = g;
         D_8024B348[idx].cn[2] = b;
         D_8024B348[idx].cn[3] = a;
+#endif
     }
 }
 
