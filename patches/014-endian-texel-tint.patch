+#ifdef WINGS64_XBOX
+// PW64: the texture tint loops below (env time-of-day colouring, env.c
+// env_802E1C1C) read and write texels as u16, but texture images stay
+// big-endian in RAM (as the RDP reads them; pw64-gfx decodes them so). Swap
+// the 16-bit images (the u16 cases: fmt 4, and fmt 1/2 at 16 bits) to host
+// order around the loops. Without it dusk/night levels got rainbow noise.
+static void pw64_tint_swap16(s32 fmt, s32 bits, s32 size, void* img) {
+    if (fmt == 4 || ((fmt == 1 || fmt == 2) && bits == 16)) {
+        PW64_SWAP16(img, size / 2);
+    }
+}
+
+#endif
