 void _uvMemFreeScratch(void* addr) {
+#ifdef WINGS64_XBOX
+    // PORT: arena addresses are not constant expressions, so the switch becomes an if chain.
+    if ((u32)addr == N64_K0(0x803DA800)) {
+#else
     switch ((u32)addr) {
     case 0x803DA800:
+#endif
         D_802B8920[0] = 0;
+#ifdef WINGS64_XBOX
+    } else if ((u32)addr == N64_K0(0x800DA800)) {
+#else
         break;
     case 0x800DA800:
+#endif
         D_802B8920[1] = 0;
+#ifdef WINGS64_XBOX
+    } else if ((u32)addr == N64_K0(0x80100000)) {
+#else
         break;
     case 0x80100000:
+#endif
         D_802B8920[2] = 0;
+#ifdef WINGS64_XBOX
+    } else {
+#else
         break;
     default:
+#endif
         _uvDebugPrintf("_uvMemFreeScratch: 0x%x not a scratch area\n", addr);
+#ifndef WINGS64_XBOX
         break;
+#endif
     }
 }
 
