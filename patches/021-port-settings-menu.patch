--- a/src/kernel/font.c
+++ b/src/kernel/font.c
@@ -457,4 +457,68 @@
     gGfxDisplayListHead--;
     D_80248E90 += sFontMsgCount;
     sFontMsgCount = 0;
+}
+
+#ifdef WINGS64_XBOX
+#include <wings64_settings.h>
+#if WINGS64_SETTINGS_MENU
+// DIVERGES: port settings menu (FPS monitor: one string printed in a game font and its display list emitted, game font state untouched)
+// Called from uvGfxEnd after the game's own text. uvFontGenDlist restarts its sprite display list at
+// base + messages-so-far, which would overwrite a batch already emitted this frame, so the overlay
+// continues from where the last batch ended (rsp_dl_next) and generates only its own message.
+int uvFontOverlayStr_port(int fontId, int x, int y, u8 r, u8 g, u8 b, const char* str) {
+    Gfx* base;
+    u32 savedId;
+    u32 savedWidth;
+    f32 savedScaleX;
+    f32 savedScaleY;
+    u8 savedR;
+    u8 savedG;
+    u8 savedB;
+    u8 savedA;
+    s32 savedCount;
+
+    if (gGfxUnkPtrs == NULL || fontId < 0 || fontId >= LEVEL_FONT_COUNT || gGfxUnkPtrs->fonts[fontId] == NULL) {
+        return 0;
+    }
+    if (sFontMsgCount >= FONT_MSG_COUNT) {
+        return 1;
+    }
+    base = &sFontSprite.rsp_dl[gGfxFbIndex * FONT_DL_COUNT];
+    if (sFontSprite.rsp_dl_next < base || sFontSprite.rsp_dl_next >= base + FONT_DL_COUNT) {
+        sFontSprite.rsp_dl_next = base; // last batch was for the other framebuffer
+    }
+    if (sFontSprite.rsp_dl_next + 16 * FONT_MAX_MSG_LEN > base + FONT_DL_COUNT) {
+        return 1; // no room left this frame
+    }
+    savedId = sFontCurId;
+    savedWidth = sFontCurWidth;
+    savedScaleX = sFontScaleX;
+    savedScaleY = sFontScaleY;
+    savedR = sFontColorR;
+    savedG = sFontColorG;
+    savedB = sFontColorB;
+    savedA = sFontColorA;
+    savedCount = sFontMsgCount;
+
+    sFontCurId = fontId;
+    sFontCurWidth = gGfxUnkPtrs->fonts[fontId]->bitmap->width;
+    sFontScaleX = 1.0f;
+    sFontScaleY = 1.0f;
+    uvFontColor(r, g, b, 0xFF);
+    uvFontPrintStr(x, y, str);
+    spInit(&gGfxDisplayListHead);
+    uvFontMsgGenDlist(&sFontMessages[savedCount]);
+    spFinish(&gGfxDisplayListHead);
+    gGfxDisplayListHead--;
+
+    sFontMsgCount = savedCount; // game text still pending stays pending
+    sFontCurId = savedId;
+    sFontCurWidth = savedWidth;
+    sFontScaleX = savedScaleX;
+    sFontScaleY = savedScaleY;
+    uvFontColor(savedR, savedG, savedB, savedA);
+    return 1;
 }
+#endif
+#endif
