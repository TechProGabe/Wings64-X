+    {
+        extern void wings64_audio_task(OSTask* task);
+
+        wings64_audio_task(&task->list);
+    }
+    osSendMesg(&__am.audioReplyMsgQ, &info->msg, OS_MESG_NOBLOCK);
+#else
     osSendMesg(_uvScGetCmdQ(&gSchedInst), &info->task, OS_MESG_BLOCK);
+#endif
     curAcmdList ^= 1;
     return 1;
 }
