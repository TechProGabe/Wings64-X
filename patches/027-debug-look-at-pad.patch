 #include "code_D2B10.h"
 #include "hud.h"
 #include "splash.h"
+#if defined(WINGS64_XBOX) && defined(WINGS64_DBG_LOOK_AT_PAD) && WINGS64_DBG_LOOK_AT_PAD > 0
+#include "pads.h"
 
+// PW64: port debug camera, off by default. DIVERGES: the flight camera looks at the first used landing
+// pad from WINGS64_DBG_LOOK_AT_PAD units away (26.6 degrees down, facing +y) to get the target on screen.
+static void wings64_look_at_pad(Mtx4F* m) {
+    LandingPad* pad = NULL;
+    f32 d = (f32)WINGS64_DBG_LOOK_AT_PAD;
+    s32 i;
+
+    for (i = 0; i < gLandingPadCount; i++) {
+        if (gLandingPads[i].isUsed) {
+            pad = &gLandingPads[i];
+            break;
+        }
+    }
+    if (pad == NULL) {
+        return;
+    }
+    m->m[0][0] = 1.0f; m->m[0][1] = 0.0f;     m->m[0][2] = 0.0f;     m->m[0][3] = 0.0f;
+    m->m[1][0] = 0.0f; m->m[1][1] = 0.8944f;  m->m[1][2] = -0.4472f; m->m[1][3] = 0.0f;
+    m->m[2][0] = 0.0f; m->m[2][1] = 0.4472f;  m->m[2][2] = 0.8944f;  m->m[2][3] = 0.0f;
+    m->m[3][0] = pad->pos.x;
+    m->m[3][1] = pad->pos.y - 0.8944f * d;
+    m->m[3][2] = pad->pos.z + 0.4472f * d;
+    m->m[3][3] = 1.0f;
+}
+#endif
