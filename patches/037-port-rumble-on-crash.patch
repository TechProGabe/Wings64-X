 void sndSetMusic(u16 musicId) {
+#ifdef WINGS64_XBOX
+    // DIVERGES: the controller rumbles when a crash jingle starts (every vehicle's crash sets one; port setting)
+    if (musicId != gCurrentMusicId &&
+        (musicId == BGM_HANG_GLIDER_CRASH || musicId == BGM_ROCKET_BELT_CRASH || musicId == BGM_GYROCOPTER_CRASH ||
+         musicId == BGM_SKYDIVING_CRASH || musicId == BGM_BIRDMAN_CRASH)) {
+        wings64_rumble_crash();
+    }
+#endif
     gCurrentMusicId = musicId;
 }
 
